# EstateIQ AI - Environment Configuration Template
# Copy this file to .env if you want to customize settings.
# All core APIs (FX, Geocoding, Overpass Amenities, Open-Meteo Weather, and Public AI)
# work out-of-the-box with ZERO private API keys required.

FLASK_ENV=development
SECRET_KEY=replace-with-a-strong-random-64-char-secret-key

# Database (SQLite by default; swap to PostgreSQL URL for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/estateiq
DATABASE_URL=

# Public Zero-Key AI Provider (enabled by default; falls back gracefully if offline)
ENABLE_PUBLIC_AI=true
PUBLIC_AI_URL=https://text.pollinations.ai/openai
PUBLIC_AI_MODEL=openai

# Optional Personal Free-Tier AI API Keys (override Public AI when provided)
# Get free keys from:
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Public External APIs Configuration (No API keys needed)
NOMINATIM_USER_AGENT=EstateIQ-AI/1.0 (contact@estateiq.local)
DEFAULT_USD_TO_INR=84.50
FX_CACHE_TTL_SECONDS=21600
GEO_CACHE_TTL_SECONDS=86400
WEATHER_CACHE_TTL_SECONDS=1800

# Admin Seed Account (change before deploying to production)
ADMIN_EMAIL=admin@estateiq.ai
ADMIN_PASSWORD=Admin@EstateIQ2026
ADMIN_NAME=EstateIQ Administrator

# Rate Limiting
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=240 per hour
